{
  "name": "GamificationActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "blog_post_read",
        "blog_post_liked",
        "blog_post_commented",
        "material_downloaded",
        "forum_post_created",
        "forum_post_liked",
        "forum_comment_created",
        "community_post_created",
        "community_post_liked"
      ]
    },
    "related_entity_id": {
      "type": "string"
    },
    "related_entity_title": {
      "type": "string"
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "Consumo de Conhecimento",
        "Intera\u00e7\u00e3o Comunit\u00e1ria",
        "Produ\u00e7\u00e3o de Conte\u00fado",
        "Evolu\u00e7\u00e3o Acad\u00eamica"
      ]
    }
  },
  "required": [
    "user_id",
    "activity_type",
    "points_awarded",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}