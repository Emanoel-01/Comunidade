{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de m\u00eddias anexadas (fotos, v\u00eddeos MP4, \u00e1udios MP3)"
    },
    "social_video_url": {
      "type": "string",
      "description": "Link de v\u00eddeo de rede social (YouTube, Instagram, LinkedIn) para embed"
    },
    "forum_title": {
      "type": "string"
    },
    "forum_category": {
      "type": "string"
    },
    "is_forum": {
      "type": "boolean",
      "default": false
    },
    "is_quiz": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o post \u00e9 uma enquete de m\u00faltipla escolha"
    },
    "quiz_options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Op\u00e7\u00f5es da enquete"
    },
    "quiz_votes": {
      "type": "object",
      "description": "Mapa de votos: chave \u00e9 o \u00edndice da op\u00e7\u00e3o, valor \u00e9 array de IDs de usu\u00e1rios"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden"
      ],
      "default": "active"
    }
  },
  "required": [
    "author_id",
    "author_name",
    "content"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}