{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "profession": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "requested_role": {
      "type": "string",
      "enum": [
        "aluno",
        "engenheiro",
        "arquiteto",
        "docente",
        "parceiro",
        "gestor_condominial",
        "consultor_bim",
        "perito_judicial",
        "corretor",
        "investidor"
      ],
      "default": "aluno"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "requested_role"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}