{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o do membro no perfil (sobrep\u00f5e o full_name do sistema)"
    },
    "bio": {
      "type": "string"
    },
    "role_label": {
      "type": "string"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "aluno",
        "engenheiro",
        "arquiteto",
        "docente",
        "parceiro",
        "gestor_condominial",
        "consultor_bim",
        "perito_judicial",
        "corretor",
        "investidor",
        "admin"
      ],
      "default": "aluno"
    },
    "license_type": {
      "type": "string",
      "enum": [
        "estudantil",
        "teste",
        "pleno",
        "vitalicio"
      ],
      "default": "teste",
      "description": "Tipo de licen\u00e7a do membro"
    },
    "license_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da licen\u00e7a"
    },
    "license_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de expira\u00e7\u00e3o da licen\u00e7a (null para vital\u00edcio)"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "formation": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "crea_cau": {
      "type": "string"
    },
    "specialization": {
      "type": "string"
    },
    "experience_years": {
      "type": "number"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_approved": {
      "type": "boolean",
      "default": true
    },
    "gamification_score_total": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o total acumulada"
    },
    "weekly_score": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o da semana atual"
    },
    "monthly_score": {
      "type": "number",
      "default": 0,
      "description": "Pontua\u00e7\u00e3o do m\u00eas atual"
    },
    "current_level": {
      "type": "string",
      "enum": [
        "Membro Trainee",
        "Membro Engajado",
        "Colaborador Ativo",
        "Especialista 4.0",
        "Embaixador da Comunidade"
      ],
      "default": "Membro Trainee"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}