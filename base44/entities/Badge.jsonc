{
  "name": "Badge",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Emoji ou \u00edcone representativo"
    },
    "color": {
      "type": "string",
      "description": "Classe de cor tailwind para o badge"
    },
    "category": {
      "type": "string",
      "enum": [
        "Consumo de Conhecimento",
        "Intera\u00e7\u00e3o Comunit\u00e1ria",
        "Produ\u00e7\u00e3o de Conte\u00fado",
        "Evolu\u00e7\u00e3o Acad\u00eamica"
      ]
    },
    "required_points": {
      "type": "number",
      "default": 0,
      "description": "Pontos necess\u00e1rios para ganhar este badge"
    },
    "required_activity_type": {
      "type": "string",
      "description": "Tipo de atividade espec\u00edfica necess\u00e1ria"
    },
    "required_activity_count": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}